---
import type { Project } from '../data/projects';
import { useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
  lang: 'sl' | 'en';
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="project-card">
  <!-- Scrollable horizontal image carousel -->
  <div class="carousel-container">
    <p class="scroll-hint">{t('projects.scrollHint')}</p>
    <div class="carousel">
      {project.images.map((imgUrl, idx) => (
        <img src={imgUrl} alt={`${project.title[lang]} photo ${idx + 1}`} loading="lazy" />
      ))}
    </div>
  </div>

  <div class="card-content">
    <h3>{project.title[lang]}</h3>
    <div class="tags">
      {project.tags.map(tag => <span class="badge">{tag}</span>)}
    </div>
    <p>{project.summary[lang]}</p>
    <a href={`/${lang}/projects/${project.slug}`} class="btn">{t('projects.viewProject')}</a>
  </div>
</article>

<style>
  .project-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .carousel-container {
    position: relative;
    background-color: #020617;
  }

  .scroll-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
    padding: 0.3rem;
    background: rgba(0,0,0,0.4);
  }

  /* Touch-friendly horizontal scroll snap gallery */
  .carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 0.5rem;
    padding: 0.5rem;
  }

  .carousel::-webkit-scrollbar {
    height: 6px;
  }

  .carousel::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 3px;
  }

  .carousel img {
    flex: 0 0 85%;
    height: 220px;
    object-fit: cover;
    border-radius: 8px;
    scroll-snap-align: center;
  }

  @media (min-width: 600px) {
    .carousel img {
      flex: 0 0 60%;
      height: 280px;
    }
  }

  .card-content {
    padding: 1.5rem;
  }

  .card-content h3 {
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .tags {
    margin-bottom: 0.8rem;
  }

  .card-content p {
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }
</style>