---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profilePic from '../../assets/profile.png';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import { homelabData } from '../../data/homelab';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'sl' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as { lang: 'sl' | 'en' };
const t = useTranslations(lang);
const homelab = homelabData[lang];
---

<Layout title={`Matjaž | ${t('hero.title')}`} lang={lang}>
  <!-- TOP HERO SECTION WITH PICTURE & DESCRIPTION -->
  <section class="hero">
    <Image 
      src={profilePic} 
      alt="Matjaž" 
      class="profile-pic"
      width={360}
      height={360}
      format="webp" 
    />
    <div class="hero-text">
      <p class="greeting">{t('hero.greeting')}</p>
      <h1>{t('hero.title')}</h1>
      <p class="bio">{t('hero.bio')}</p>
    </div>
  </section>

  <!-- NOTABLE PROJECTS SECTION -->
  <section id="projects" class="section">
    <h2>{t('projects.heading')}</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>

  <!-- HOMELAB SUMMARY SECTION -->
  <section class="section homelab-section">
    <h2>{t('homelab.heading')}</h2>
    <div class="homelab-card">
      <img src={homelab.image} alt={homelab.title} class="homelab-img" />
      <div class="homelab-info">
        <h3>{homelab.subtitle}</h3>
        <p>{homelab.description}</p>
        <a href={`/${lang}/homelab`} class="btn">{t('homelab.readMore')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Responsive Hero Section */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .profile-pic {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--accent);
  }

  .greeting {
    color: var(--accent);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .hero-text h1 {
    font-size: 2rem;
    margin: 0.3rem 0 1rem 0;
  }

  .bio {
    color: var(--text-muted);
    max-width: 650px;
  }

  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
      text-align: left;
    }
    .profile-pic {
      width: 180px;
      height: 180px;
    }
  }

  .section {
    margin-top: 4rem;
  }

  .section h2 {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  /* Homelab card layout */
  .homelab-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .homelab-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .homelab-info {
    padding: 1.5rem;
  }

  .homelab-info h3 {
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .homelab-info p {
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }

  @media (min-width: 768px) {
    .homelab-card {
      flex-direction: row;
      align-items: center;
    }
    .homelab-img {
      width: 45%;
      height: 260px;
    }
    .homelab-info {
      width: 55%;
    }
  }
</style>