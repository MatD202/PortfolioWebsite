---
import Layout from '../../../layouts/Layout.astro';
import { projects } from '../../../data/projects';
import { marked } from 'marked';

export function getStaticPaths() {
  const paths: Array<{ params: { lang: 'sl' | 'en'; slug: string } }> = [];
  const langs: Array<'sl' | 'en'> = ['sl', 'en'];

  for (const lang of langs) {
    for (const proj of projects) {
      paths.push({
        params: { lang, slug: proj.slug }
      });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: 'sl' | 'en'; slug: string };
const project = projects.find(p => p.slug === slug);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

// Markdown is authored locally in src/data/projects.ts.
const detailsHtml = marked.parse(project.details[lang], { async: false });
---

<Layout title={`${project.title[lang]} | Portfolio`} lang={lang}>
  <article class="project-detail">
    <a href={`/${lang}/#projects`} class="back-link">← {lang === 'sl' ? 'Nazaj na projekte' : 'Back to Projects'}</a>

    <h1>{project.title[lang]}</h1>
    
    <div class="tags">
      {project.tags.map(tag => <span class="badge">{tag}</span>)}
    </div>

    <!-- Scrollable Photo Gallery -->
    <div class="gallery">
      {project.images.map((img, idx) => (
        <img src={img} alt={`${project.title[lang]} detail image ${idx + 1}`} />
      ))}
    </div>

    <div class="content">
      <h2>{lang === 'sl' ? 'O Projektu' : 'About the Project'}</h2>
      <div class="markdown" set:html={detailsHtml} />
    </div>
  </article>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .project-detail h1 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }
  .tags {
    margin-bottom: 1.5rem;
  }
  .gallery {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }
  .gallery img {
    flex: 0 0 90%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 12px;
    scroll-snap-align: center;
  }
  @media (min-width: 768px) {
    .gallery img {
      flex: 0 0 70%;
    }
  }
  .markdown {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .markdown :global(> * + *) {
    margin-top: 1rem;
  }
  .markdown :global(h1),
  .markdown :global(h2),
  .markdown :global(h3),
  .markdown :global(h4),
  .markdown :global(h5),
  .markdown :global(h6) {
    color: var(--text-main);
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .markdown :global(ul),
  .markdown :global(ol) {
    padding-left: 1.5rem;
  }
  .markdown :global(li + li) {
    margin-top: 0.4rem;
  }
  .markdown :global(li > ul),
  .markdown :global(li > ol) {
    margin-top: 0.4rem;
  }
  .markdown :global(a) {
    text-decoration: underline;
  }
  .markdown :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
  }
  .markdown :global(code) {
    background: var(--card-bg);
    border-radius: 4px;
    padding: 0.15em 0.3em;
    font-size: 0.9em;
  }
  .markdown :global(pre) {
    background: var(--card-bg);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
  }
  .markdown :global(pre code) {
    padding: 0;
  }
  .markdown :global(img) {
    max-width: 100%;
    height: auto;
  }
  .markdown :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .markdown :global(th),
  .markdown :global(td) {
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.75rem;
  }
  .markdown :global(hr) {
    border: 0;
    border-top: 1px solid var(--border-color);
  }
</style>
